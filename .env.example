# Copy this file to .env.local and fill in values from your Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
# A legacy anon key is also supported via VITE_SUPABASE_ANON_KEY.
# Never place a secret or service_role key in a VITE_ variable.
